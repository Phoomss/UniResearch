# ──────────────────────────────────────────────────────────────────────────────
# UniResearch – Docker Environment Configuration
# Copy this file:  cp .env.docker .env
# ──────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=uniresearch
DB_PORT=5433

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
PROJECT_NAME=UniResearch
SECRET_KEY=supersecretkey-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV=development
BACKEND_PORT=8000
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
MAX_COVER_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=26214400

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
FRONTEND_PORT=3000
