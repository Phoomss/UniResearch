PROJECT_NAME=UniResearch
# Local PostgreSQL configuration:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/uniresearch
# Supabase PostgreSQL configuration (direct connection, replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF]):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
SECRET_KEY=supersecretkey-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV=development
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
MAX_COVER_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=26214400

# Database SSL settings (Optional: True/False. Auto-detected if not specified)
# DB_SSL=True
