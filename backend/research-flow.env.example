# Keep secrets in your existing environment/secret store.
RESEARCH_FLOW_ENABLED=true
RESEARCH_FLOW_PROVIDER=gemini
# Existing GEMINI_API_KEY, AI_ENABLED and AI_MODEL are reused.
# Optional JSON mapping of planner/paper/evidence/verifier/critic/writer/citation to model names.
RESEARCH_FLOW_AGENT_MODELS={}
RESEARCH_FLOW_MAX_RESEARCH_ITERATIONS=3
RESEARCH_FLOW_MAX_AGENT_RETRIES=2
RESEARCH_FLOW_MAX_SEARCH_ROUNDS=3
RESEARCH_FLOW_MAX_PAPERS=20
RESEARCH_FLOW_PAPER_BATCH_SIZE=3
RESEARCH_FLOW_MAX_WORKFLOW_DURATION=900
RESEARCH_FLOW_AGENT_TIMEOUT=90
RESEARCH_FLOW_MAX_LLM_CALLS=40
RESEARCH_FLOW_MAX_TOKENS=100000
RESEARCH_FLOW_OUTPUT_TOKENS=4096
RESEARCH_FLOW_MAX_CONTEXT_CHARS=40000
RESEARCH_FLOW_MAX_ACTIVE_PER_USER=2
RESEARCH_FLOW_MAX_ACTIVE_GLOBAL=20
RESEARCH_FLOW_CREATIONS_PER_HOUR=10
RESEARCH_FLOW_DEPTH_SOURCES={"QUICK":5,"STANDARD":10,"DEEP":20}
RESEARCH_FLOW_POLL_SECONDS=2
